{
  "servers": {
    "todo-confluence": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/mcp/confluence-server.mjs"],
      "envFile": "${workspaceFolder}/.env"
    },
    "todo-github": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/mcp/github-server.mjs"],
      "envFile": "${workspaceFolder}/.env"
    },
    "todo-git": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/mcp/git-server.mjs"]
    },
    "github": {
      "type": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "envFile": "${workspaceFolder}/.env"
    }
  }
}