# Copy to .env (never commit .env). Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_BASE_URL=https://bahuddurshashaik.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=CP
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your-api-token
# Optional: title of the parent page that groups the stories
CONFLUENCE_PARENT_TITLE=To Do Application - User Stories
# GitHub pull requests. Create a fine-grained token at https://github.com/settings/tokens
# with "Pull requests: Read and write" and "Contents: Read" on this repository.
GITHUB_TOKEN=your-token
GITHUB_REPOSITORY=bahuddurshashaik-lgtm/Capstone_project
GITHUB_BASE_BRANCH=main
